{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio desktop monorepo",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev --workspace=@folio/desktop",
    "build": "npm run build --workspace=@folio/desktop",
    "package": "npm run package --workspace=@folio/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
