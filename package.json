{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio desktop monorepo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @folio/desktop dev",
    "build": "pnpm --filter @folio/desktop build",
    "package": "pnpm --filter @folio/desktop package",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.0-rc.112"
    }
  }
}
