{
  "name": "@folio/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron-independent Folio agent runtime and ACP v2 server",
  "files": [
    "src",
    "dist",
    "scripts",
    "M0-SPIKE.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./config": "./src/config/index.ts",
    "./config/schema": "./src/config/schema.ts",
    "./config/directory": "./src/config/directory.ts",
    "./config/loader": "./src/config/loader.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:codex-protocol": "pnpm build && node scripts/codex-protocol-spike.mjs",
    "test:codex-skills": "pnpm build && node scripts/codex-skills-spike.mjs",
    "test:live-provider-policy": "node scripts/live-provider-policy-check.mjs",
    "test:live-provider": "pnpm build && node scripts/live-provider-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
