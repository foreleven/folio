{
  "name": "@folio/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron-independent Folio agent runtime and ACP v2 server",
  "files": [
    "dist",
    "scripts",
    "M0-SPIKE.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./model": "./dist/model/index.js",
    "./config": "./dist/config/index.js",
    "./config/schema": "./dist/config/schema.js",
    "./config/directory": "./dist/config/directory.js",
    "./config/loader": "./dist/config/loader.js",
    "./testing": "./dist/testing/index.js"
  },
  "bin": {
    "folio-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live-provider-policy": "node scripts/live-provider-policy-check.mjs",
    "test:live-provider": "npm run build && node scripts/live-provider-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "effect": "4.0.0-rc.112",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
