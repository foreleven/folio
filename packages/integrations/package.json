{
  "name": "@folio/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vault integrations and their installation lifecycles",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./protocol": "./src/base/protocol.ts",
    "./lark": "./src/lark/index.ts",
    "./gmail": "./src/gmail/index.ts"
  },
  "scripts": {
    "test:lark:install": "vitest run --config vitest.live.config.ts tests/install-lark.test.ts",
    "test:lark:verify": "vitest run --config vitest.live.config.ts tests/verify-lark.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@larksuiteoapi/node-sdk": "1.73.3",
    "effect": "4.0.0-rc.112",
    "google-auth-library": "10.5.0",
    "googleapis": "171.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
